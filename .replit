modules = ["java-graalvm22.3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Executar Java"

[[workflows.workflow]]
name = "Executar Java"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run-java.sh"

[workflows.workflow.metadata]
outputType = "console"
